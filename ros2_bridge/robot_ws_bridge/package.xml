<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_ws_bridge</name>
  <version>0.1.0</version>
  <description>WS сервер на роботе как ROS2 node: JSON команды → ROS2, статусы → WS.</description>

  <maintainer email="devnull@example.com">robot-team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!--
    Зависимость Python `websockets` управляется через pip/venv/образ.
    ROS2 пакетный менеджер её не устанавливает автоматически.
  -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

