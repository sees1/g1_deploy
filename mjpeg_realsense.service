[Unit]
Description=RealSense MJPEG Stream Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree
ExecStart=/usr/bin/python3 /home/unitree/mjpeg_realsense_server.py --device /dev/video2 --width 1280 --height 720 --fps 15 --port 8091
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
